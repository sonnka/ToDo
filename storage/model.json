{
  "container": "noteapplication",
  "connectionId": "mongo:diia-card",
  "timestamps": true,
  "version": true,
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["userIdentifier", "noteType"],
    "properties": {
      "userIdentifier": { "type": "string" },
      "noteType": {
        "type": "string",
        "enum": ["personal", "work"]
      },
      "noteStatus": {
        "type": "string",
        "enum": ["active", "archive"]
      }
    }
  }
}